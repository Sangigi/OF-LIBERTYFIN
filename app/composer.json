{
    "name": "grupoideas/libertyfin",
    "description": "LibertyFin: punto de venta, cobranza y comisiones para negocios de servicios.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/yaml": "^6.4"
    },
    "autoload-dev": {
        "psr-4": {
            "LibertyFin\\Pruebas\\": "tests/"
        }
    },
    "scripts": {
        "pruebas": "phpunit --testsuite unidad",
        "pruebas:integracion": "phpunit --testsuite integracion",
        "pruebas:todo": "phpunit",
        "revisar": [
            "@php herramientas/revisar-sintaxis.php",
            "@php herramientas/revisar-rutas.php",
            "@php herramientas/revisar-columnas.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform-check": false
    }
}
